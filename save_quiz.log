[2025-10-30 00:12:34] REQUEST: {"course_id":"1","course_level":"Beginner","lesson_title":"HTML","score":5,"max_score":15,"mcqs":[{"question":"What does HTML stand for?","answer":"Hypertext Markup Language","correct_answer":"Hypertext Markup Language","points":1,"max_points":1,"options":["Hypertext Markup Language","Hightext Markup Language","Hyperlink and Text Markup Language","Hypertext and Multilayer Language"]},{"question":"Which of the following elements is used to create a hyperlink in HTML?","answer":"<a>","correct_answer":"<a>","points":1,"max_points":1,"options":["<link>","<a>","<href>","<url>"]},{"question":"Which tag is used to define an unordered list in HTML?","answer":"<ul>","correct_answer":"<ul>","points":1,"max_points":1,"options":["<ol>","<ul>","<li>","<list>"]},{"question":"What is the correct HTML element for inserting a line break?","answer":"<br>","correct_answer":"<br>","points":1,"max_points":1,"options":["<break>","<br>","<lb>","<linebreak>"]},{"question":"Which attribute is used to provide a unique identifier for an HTML element?","answer":"id","correct_answer":"id","points":1,"max_points":1,"options":["class","id","name","type"]}],"shorts":[{"question":"What is the purpose of HTML?","answer":"","correct_answer":"HTML is used to create the structure and layout of web pages.","points":0,"max_points":2},{"question":"Name a common HTML element used for images.","answer":"","correct_answer":"<img> is the common HTML element used for images.","points":0,"max_points":2},{"question":"What is the role of the <head> section in an HTML document?","answer":"","correct_answer":"The <head> section contains meta-information about the document, such as title and links to stylesheets.","points":0,"max_points":2}],"long":[{"question":"Explain the structure of a basic HTML document.","answer":"","correct_answer":"A basic HTML document consists of several key sections: The document starts with a declaration of the document type using <!DOCTYPE html>. The <html> tag wraps the entire document. Inside the <html> tag, there are two main sections: the <head> and the <body>. The <head> section contains meta-information, such as the title of the document (inside <title> tags) and links to stylesheets or scripts. The <body> section contains the content of the web page, including text, images, links, and other elements. This structure allows web browsers to render the content correctly.","points":0,"max_points":4}]}
